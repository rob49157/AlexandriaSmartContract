# Copy this file to .env and fill in your values. Never commit .env to git.

# Base Testnet RPC (e.g. from Alchemy or Infura)
BASE_TESTNET_RPC_URL=https://base-sepolia.g.alchemy.com/v2/YOUR_KEY_HERE

# Private key of the deployer wallet (no 0x prefix needed)
DEPLOYER_PRIVATE_KEY=your_private_key_here

# Basescan API key for contract verification
BASESCAN_API_KEY=your_basescan_api_key_here
